# Aqeelah's Beauty Empire (ABE) Flutter --dart-define template
# Copy to .env.dev.json / .env.staging.json / .env.prod.json (git-ignored) and pass via:
# flutter build appbundle --release --flavor prod --dart-define-from-file=.env.prod.json
# NEVER place PAYSTACK_SECRET_KEY or PEACH_WEBHOOK_SECRET in Flutter client config files.
{
  "ABE_ENV": "prod",
  "PAYSTACK_PUBLIC_KEY": "pk_live_replace_with_paystack_public_key",
  "PEACH_ENTITY_ID": "replace_with_peach_entity_id",
  "RECAPTCHA_V3_SITE_KEY": "replace_with_firebase_appcheck_recaptcha_v3_site_key"
}
